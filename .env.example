# MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/restaurante?retryWrites=true&w=majority

# Segredo do token JWT (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-segredo-bem-grande

# Cloudinary (copie o "API environment variable" do painel)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# E-mail do 2º fator (exemplo com Gmail + senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app-do-google
SMTP_FROM="Zeca Restaurant <seuemail@gmail.com>"
